# Site kök URL'i — canonical, hreflang, sitemap ve schema.org için.
NEXT_PUBLIC_SITE_URL=https://hibrid360.com

# Supabase (supabase/migrations + docs/supabase-schema.sql). Tanımlı değilse
# içerik sorguları boş döner ve sayfalar "hazırlanıyor" boş durumunu gösterir.
# Yalnızca publishable/anon anahtar kullanılır; service_role key asla client
# env'e girmez. NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY güncel isimdir; eski
# ANON_KEY fallback olarak desteklenir.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics — brief Bölüm 1.7: GA4 veya Plausible, çerez onayına bağlı.
# İkisi de boşsa hiçbir analytics scripti yüklenmez (varsayılan).
# Yalnızca kullanıcı analitik çerezine rıza verdiğinde devreye girer.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=
